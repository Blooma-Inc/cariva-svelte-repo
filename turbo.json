{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["sync", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".svelte-kit/**", "build/**", "dist/**", ".vercel/**"]
    },
    "sync": {
      "outputs": [".svelte-kit/**"]
    },
    "check-types": {
      "dependsOn": ["sync"]
    },
    "lint": {
      "dependsOn": ["sync"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
