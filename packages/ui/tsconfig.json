{
  "extends": ["@cariva/typescript-config/svelte.json", "./.svelte-kit/tsconfig.json"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "allowArbitraryExtensions": true,
    "strictNullChecks": true,
    "types": ["svelte", "@sveltejs/kit"]
  },
  "include": ["./src/**/*.svelte", "./src/**/*.ts", "./tests/**/*.svelte", "./tests/**/*.ts"],
  "exclude": ["node_modules", ".svelte-kit", "dist"]
}
